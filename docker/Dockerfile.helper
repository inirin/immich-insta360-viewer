FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/helper/package.json apps/helper/package.json
COPY apps/viewer/package.json apps/viewer/package.json
RUN pnpm install --frozen-lockfile
COPY apps apps
RUN pnpm --filter @immich-insta360-viewer/viewer build
RUN pnpm --filter @immich-insta360-viewer/helper build
RUN mkdir -p apps/helper/viewer-dist && cp -r apps/viewer/dist/* apps/helper/viewer-dist/
RUN pnpm --filter @immich-insta360-viewer/helper deploy --legacy --prod /prod/helper

FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg \
  && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
COPY --from=build /prod/helper/node_modules ./node_modules
COPY --from=build /prod/helper/package.json ./package.json
COPY --from=build /prod/helper/dist ./dist
COPY --from=build /app/apps/helper/viewer-dist ./viewer-dist
RUN mkdir -p /cache
EXPOSE 3560
CMD ["node", "dist/server.js"]
